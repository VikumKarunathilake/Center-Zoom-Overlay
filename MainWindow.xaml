<Window x:Class="Center_Zoom_Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zoom Overlay"
        Width="100"
        Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <!-- Circular Clip to make the image appear like a scope lens -->
        <Border x:Name="ScopeBorder"
                BorderBrush="#02000000"
                BorderThickness="1"
                CornerRadius="50">
            <Border.Clip>
                <EllipseGeometry x:Name="ScopeClipGeometry" Center="50,50" RadiusX="50" RadiusY="50" />
            </Border.Clip>
            <Image x:Name="ZoomDisplay"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="Linear"/>
        </Border>

        <!-- Dynamic Crosshair Elements -->
        <Grid x:Name="CrosshairContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Center Dot Style -->
            <Ellipse x:Name="CrosshairDot"
                     Fill="Red"
                     Width="4"
                     Height="4"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="Visible"/>

            <!-- Circle Style -->
            <Ellipse x:Name="CrosshairCircle"
                     Stroke="Red"
                     StrokeThickness="1.5"
                     Width="12"
                     Height="12"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="Collapsed"/>

            <!-- Cross Style -->
            <Grid x:Name="CrosshairCross" Visibility="Collapsed" Width="16" Height="16">
                <Line x:Name="LineH" X1="0" Y1="8" X2="16" Y2="8" Stroke="Red" StrokeThickness="1.5"/>
                <Line x:Name="LineV" X1="8" Y1="0" X2="8" Y2="16" Stroke="Red" StrokeThickness="1.5"/>
            </Grid>
        </Grid>
    </Grid>

</Window>